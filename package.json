{
  "name": "fieldsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"next dev --hostname 127.0.0.1 --port 3001\" \"tsx watch server/index.ts\"",
    "build": "next build",
    "start:web": "next start --hostname 127.0.0.1 --port 3001",
    "start:api": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "user:create": "tsx server/provision.ts",
    "check": "tsc --noEmit",
    "test:integration": "tsx --test tests/api.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/http-proxy": "^11.6.10",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "idb": "^8.0.4",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "ws": "^8.23.0"
  }
}
